rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(gid) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members;
    }
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /trips/{tid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }
    match /groups/{gid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && (
        resource.data.owner == request.auth.uid ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
        )
      );
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
      match /members/{mid} {
        allow read: if isMember(gid);
        allow create, update: if isMember(gid) && request.auth.uid == mid;
      }
      match /trips/{tripId} {
        allow read: if isMember(gid);
        allow create: if isMember(gid) && request.resource.data.owner == request.auth.uid;
        allow update, delete: if isMember(gid) && resource.data.owner == request.auth.uid;
        match /photos/{pid} {
          allow read: if isMember(gid);
          allow create, update: if isMember(gid) && request.resource.data.owner == request.auth.uid;
          allow delete: if isMember(gid) && resource.data.owner == request.auth.uid;
        }
        match /photosBig/{pid} {
          allow read: if isMember(gid);
          allow create, update: if isMember(gid) && request.resource.data.owner == request.auth.uid;
          allow delete: if isMember(gid) && resource.data.owner == request.auth.uid;
        }
      }
    }
  }
}
