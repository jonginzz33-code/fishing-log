rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'jonginzz33@gmail.com'; }
    // 관리자가 이용 정지한 계정은 글쓰기·그룹 활동 불가
    function notBanned() {
      return signedIn() && !exists(/databases/$(database)/documents/bans/$(request.auth.uid));
    }
    function isGroupOwner(gid) {
      return signedIn() &&
        get(/databases/$(database)/documents/groups/$(gid)).data.owner == request.auth.uid;
    }
    function isMember(gid) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members;
    }
    // 관리자가 켜 준 권한 (users/{uid}.perms.이름 == true)
    function hasPerm(p) {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('perms', {}).get(p, false) == true;
    }
    function trashDoc(tid) { return get(/databases/$(database)/documents/trash/$(tid)).data; }
    function reportDoc(target) { return /databases/$(database)/documents/reports/$(target); }
    function reportBy(target) { return /databases/$(database)/documents/reports/$(target)/by/$(request.auth.uid); }

    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // 권한(perms)은 관리자만 바꿈
      allow create: if signedIn() && request.auth.uid == uid && !('perms' in request.resource.data);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['perms']));
      allow delete: if signedIn() && request.auth.uid == uid;
      match /trips/{tid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---- 닉네임 (중복 금지, 언제든 바꾸기) ----
    match /nicknames/{k} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ---- 이용 정지 (관리자만 정지·해제) ----
    match /bans/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /bannedDevices/{dev} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ---- 신고 누적 (차단한 사람 수) ----
    match /reports/{target} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['n', 'updated'])
        && request.resource.data.n == 1
        && existsAfter(reportBy(target)) && !exists(reportBy(target));
      allow update: if isAdmin() || (signedIn()
        && request.resource.data.keys().hasOnly(['n', 'updated'])
        && (
          (request.resource.data.n == resource.data.n + 1 && existsAfter(reportBy(target)) && !exists(reportBy(target)))
          ||
          (request.resource.data.n == resource.data.n - 1 && !existsAfter(reportBy(target)) && exists(reportBy(target)))
        ));
      allow delete: if isAdmin();
      match /by/{u} {
        allow read: if signedIn() && (request.auth.uid == u || isAdmin());
        allow create: if signedIn() && request.auth.uid == u && (
          (!exists(reportDoc(target)) && getAfter(reportDoc(target)).data.n == 1)
          ||
          (exists(reportDoc(target)) && getAfter(reportDoc(target)).data.n == get(reportDoc(target)).data.n + 1)
        );
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == u
          && exists(reportDoc(target))
          && getAfter(reportDoc(target)).data.n == get(reportDoc(target)).data.n - 1);
      }
    }

    // ---- 채팅 (전체방) · 채팅 금지 · 접속 중 ----
    function chatOk() {
      return notBanned() && !exists(/databases/$(database)/documents/chatMute/$(request.auth.uid));
    }
    function chatMsg() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.t is int;
    }
    match /chat/{mid} {
      allow read: if signedIn();
      allow create: if chatOk() && chatMsg();
      allow update: if chatOk() && resource.data.uid == request.auth.uid && chatMsg();
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin() || hasPerm('chatMod'));
    }
    match /chatMute/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // ---- 1:1 문의 (문의한 사람과 운영자만) ----
    match /inquiries/{uid} {
      allow read, write: if signedIn() && (request.auth.uid == uid || isAdmin());
      match /msgs/{mid} {
        allow read, create: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow update, delete: if isAdmin();
      }
    }

    // ---- 휴지통 (남이 지운 내 조과 30일 보관) · 알림 ----
    match /trash/{tid} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid
        && (isAdmin() || (request.resource.data.kind == 'group' && isGroupOwner(request.resource.data.gid)));
      allow read: if signedIn() && (resource.data.owner == request.auth.uid || resource.data.by == request.auth.uid || isAdmin());
      allow delete: if signedIn() && (resource.data.owner == request.auth.uid || isAdmin());
      match /items/{iid} {
        allow read, write: if signedIn() && (trashDoc(tid).owner == request.auth.uid || trashDoc(tid).by == request.auth.uid || isAdmin());
      }
    }
    match /notify/{nid} {
      allow create: if signedIn();
      allow read, delete: if signedIn() && resource.data.to == request.auth.uid;
    }

    // ---- 날씨 저장 (최신 값을 못 받을 때 대비) ----
    match /wx/{id} {
      allow read, write: if signedIn();
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow update: if signedIn() && resource.data.owner == request.auth.uid
        && request.resource.data.gid == resource.data.gid;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }
    match /public/{pid} {
      allow read: if signedIn();
      allow create: if notBanned() && request.resource.data.owner == request.auth.uid;
      allow update: if notBanned() && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;
      allow delete: if signedIn() && (resource.data.owner == request.auth.uid || isAdmin());
      match /photos/{ph} {
        allow read: if signedIn();
        allow create, update: if notBanned() && request.resource.data.owner == request.auth.uid;
        allow delete: if signedIn() && (resource.data.owner == request.auth.uid || isAdmin());
      }
    }
    match /groups/{gid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // 그룹 만들기: 운영자 또는 '그룹 만들기' 권한을 받은 사람만
      allow create: if notBanned() && (isAdmin() || hasPerm('group'))
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && (
        resource.data.owner == request.auth.uid ||
        (
          notBanned()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
        )
        ||
        (
          // 그룹 탈퇴: 나만 빠짐
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.auth.uid in resource.data.members
          && !(request.auth.uid in request.resource.data.members)
          && resource.data.members.hasAll(request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1
        )
      );
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
      match /members/{mid} {
        allow read: if isMember(gid);
        allow create, update: if isMember(gid) && request.auth.uid == mid;
        allow delete: if isGroupOwner(gid) || request.auth.uid == mid;
      }
      match /live/{mid} {
        allow read: if isMember(gid);
        allow create, update: if isMember(gid) && notBanned() && request.auth.uid == mid;
        allow delete: if signedIn() && (request.auth.uid == mid || isGroupOwner(gid));
      }
      match /meta/{mid} {
        allow read: if isMember(gid);
        allow write: if isGroupOwner(gid);
      }
      match /chat/{mid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid) && chatOk() && chatMsg();
        allow update: if isMember(gid) && chatOk() && resource.data.uid == request.auth.uid && chatMsg();
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isGroupOwner(gid) || isAdmin());
      }
      match /notices/{nid} {
        allow read: if isMember(gid);
        allow create, update, delete: if isGroupOwner(gid);
      }
      match /events/{eid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid) && notBanned() && request.resource.data.owner == request.auth.uid;
        allow update, delete: if isMember(gid) && (resource.data.owner == request.auth.uid || isGroupOwner(gid));
      }
      match /trips/{tripId} {
        allow read: if isMember(gid);
        allow create: if isMember(gid) && notBanned() && request.resource.data.owner == request.auth.uid;
        allow update: if isMember(gid) && notBanned() && resource.data.owner == request.auth.uid;
        allow delete: if isMember(gid) && (resource.data.owner == request.auth.uid || isGroupOwner(gid));
        match /photos/{pid} {
          allow read: if isMember(gid);
          allow create, update: if isMember(gid) && notBanned() && request.resource.data.owner == request.auth.uid;
          allow delete: if isMember(gid) && (resource.data.owner == request.auth.uid || isGroupOwner(gid));
        }
        match /photosBig/{pid} {
          allow read: if isMember(gid);
          allow create, update: if isMember(gid) && notBanned() && request.resource.data.owner == request.auth.uid;
          allow delete: if isMember(gid) && (resource.data.owner == request.auth.uid || isGroupOwner(gid));
        }
        match /detail/{did} {
          allow read: if isMember(gid);
          allow create, update: if isMember(gid) && notBanned() && request.resource.data.owner == request.auth.uid;
          allow delete: if isMember(gid) && (resource.data.owner == request.auth.uid || isGroupOwner(gid));
        }
      }
    }
  }
}
