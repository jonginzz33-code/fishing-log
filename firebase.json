{
    "hosting":  [
                    {
                        "public":  "site",
                        "cleanUrls":  true,
                        "ignore":  [
                                       "firebase.json",
                                       "**/.*"
                                   ],
                        "headers":  [
                                        {
                                            "source":  "**",
                                            "headers":  [
                                                            {
                                                                "key":  "Cache-Control",
                                                                "value":  "no-cache"
                                                            }
                                                        ]
                                        },
                                        {
                                            "source":  "/img/**",
                                            "headers":  [
                                                            {
                                                                "key":  "Cache-Control",
                                                                "value":  "max-age=86400"
                                                            }
                                                        ]
                                        },
                                        {
                                            "source":  "/data/**",
                                            "headers":  [
                                                            {
                                                                "key":  "Cache-Control",
                                                                "value":  "max-age=600"
                                                            }
                                                        ]
                                        },
                                        {
                                            "source":  "/geo{,.html}",
                                            "headers":  [
                                                            {
                                                                "key":  "X-Frame-Options",
                                                                "value":  "DENY"
                                                            },
                                                            {
                                                                "key":  "Content-Security-Policy",
                                                                "value":  "frame-ancestors \u0027none\u0027"
                                                            },
                                                            {
                                                                "key":  "X-Content-Type-Options",
                                                                "value":  "nosniff"
                                                            },
                                                            {
                                                                "key":  "Referrer-Policy",
                                                                "value":  "same-origin"
                                                            }
                                                        ]
                                        }
                                    ],
                        "target":  "main"
                    },
                    {
                        "target":  "danga",
                        "public":  "site-danga",
                        "cleanUrls":  true,
                        "ignore":  [
                                       "firebase.json",
                                       "**/.*"
                                   ],
                        "headers":  [
                                        {
                                            "headers":  [
                                                            {
                                                                "key":  "Cache-Control",
                                                                "value":  "no-cache"
                                                            }
                                                        ],
                                            "source":  "**"
                                        }
                                    ]
                    }
                ]
}